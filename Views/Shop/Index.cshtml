@model NexusStore.Models.ViewModels.ShopViewModel
@{
    ViewData["Title"] = "Catalog & Collections";
}

<div class="container-fluid px-3 px-md-4 py-4 max-w-1400" style="max-width: 1400px; margin: 0 auto;">
    <!-- Breadcrumb & Header Title -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Collections</a></li>
                @if (!string.IsNullOrEmpty(Model.SelectedCategorySlug))
                {
                    <li class="breadcrumb-item active" aria-current="page">@Model.Categories.FirstOrDefault(c => c.Slug == Model.SelectedCategorySlug)?.Name</li>
                }
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 style="font-family: var(--font-heading); font-size: 2.4rem; font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: 0.2rem;">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <span>Results for "@Model.SearchQuery"</span>
                    }
                    else if (!string.IsNullOrEmpty(Model.SelectedCategorySlug))
                    {
                        <span>@Model.Categories.FirstOrDefault(c => c.Slug == Model.SelectedCategorySlug)?.Name</span>
                    }
                    else
                    {
                        <span>All Collections</span>
                    }
                </h1>
                <p class="text-muted mb-0" style="font-size: 0.9rem;">Showing @Model.TotalCount high-performance items</p>
            </div>

            <!-- Sorting Dropdown -->
            <form method="get" asp-action="Index" id="sortForm" class="d-flex align-items-center gap-2">
                <input type="hidden" name="category" value="@Model.SelectedCategorySlug" />
                <input type="hidden" name="search" value="@Model.SearchQuery" />
                @if (Model.OnlyInStock)
                {
                    <input type="hidden" name="inStock" value="true" />
                }
                <label for="sortSelect" class="text-muted fw-bold small text-nowrap" style="font-family: var(--font-heading); text-transform: uppercase; font-size: 0.78rem;">Sort By:</label>
                <select name="sort" id="sortSelect" class="form-select form-select-sm rounded-pill px-3 py-2 border" style="min-width: 190px; font-weight: 600;" onchange="this.form.submit()">
                    <option value="featured" selected="@(Model.SortBy == "featured")">Featured & Top Picks</option>
                    <option value="price-asc" selected="@(Model.SortBy == "price-asc")">Price: Low to High</option>
                    <option value="price-desc" selected="@(Model.SortBy == "price-desc")">Price: High to Low</option>
                    <option value="rating" selected="@(Model.SortBy == "rating")">Highest Rated</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest Drops</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Quick Category Horizontal Pills Bar -->
    <div class="d-flex gap-2 mb-4 overflow-auto pb-2" style="scrollbar-width: none;">
        <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-sort="@Model.SortBy" 
           class="category-quick-pill @(string.IsNullOrEmpty(Model.SelectedCategorySlug) && !Model.SelectedCategoryId.HasValue ? "active" : "")">
            <span>All Gear</span>
            <span class="pill-count">@Model.TotalCount</span>
        </a>
        @foreach (var cat in Model.Categories)
        {
            var isCatActive = Model.SelectedCategorySlug == cat.Slug || Model.SelectedCategoryId == cat.Id;
            <a asp-action="Index" asp-route-category="@cat.Slug" asp-route-search="@Model.SearchQuery" asp-route-sort="@Model.SortBy" 
               class="category-quick-pill @(isCatActive ? "active" : "")">
                <span>@cat.Name</span>
            </a>
        }
    </div>

    <!-- Mobile Filter Toggle Button -->
    <div class="d-lg-none mb-3">
        <button type="button" class="btn btn-outline-dark w-100 py-2 fw-bold d-flex align-items-center justify-content-center gap-2 rounded-pill" onclick="toggleMobileFilters()">
            <span>⚙️ Filter & Refine Options</span>
            @if (Model.OnlyInStock || Model.MinPrice.HasValue || Model.MaxPrice.HasValue || !string.IsNullOrEmpty(Model.SelectedCategorySlug))
            {
                <span class="badge bg-dark text-white rounded-pill">Active</span>
            }
        </button>
    </div>

    <!-- Shop Content Grid with Sidebar -->
    <div class="shop-layout">

        <!-- Filters Sidebar -->
        <aside class="filter-sidebar">
            <form method="get" asp-action="Index" id="filterForm">
                <input type="hidden" name="sort" value="@Model.SortBy" />

                <!-- Search Filter -->
                <div class="filter-group">
                    <div class="filter-title">Search</div>
                    <div class="position-relative">
                        <input type="text" name="search" class="form-control form-control-sm rounded-pill ps-3" 
                               placeholder="Filter by keyword..." value="@Model.SearchQuery" />
                    </div>
                </div>

                <!-- Category Filter -->
                <div class="filter-group">
                    <div class="filter-title">Categories</div>
                    <ul class="category-filter-list">
                        <li class="category-filter-item @(string.IsNullOrEmpty(Model.SelectedCategorySlug) && !Model.SelectedCategoryId.HasValue ? "active" : "")">
                            <a asp-action="Index" asp-route-search="@Model.SearchQuery" asp-route-sort="@Model.SortBy">
                                <span>All Categories</span>
                                <span class="badge bg-light text-dark rounded-pill">All</span>
                            </a>
                        </li>
                        @foreach (var cat in Model.Categories)
                        {
                            var isActive = Model.SelectedCategorySlug == cat.Slug || Model.SelectedCategoryId == cat.Id;
                            <li class="category-filter-item @(isActive ? "active" : "")">
                                <a asp-action="Index" asp-route-category="@cat.Slug" asp-route-search="@Model.SearchQuery" asp-route-sort="@Model.SortBy">
                                    <span>@cat.Name</span>
                                    <span>→</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Availability Filter -->
                <div class="filter-group">
                    <div class="filter-title">Availability</div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="inStock" value="true" id="checkInStock" 
                               @(Model.OnlyInStock ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label small fw-semibold" for="checkInStock">
                            In Stock Only
                        </label>
                    </div>
                </div>

                <!-- Price Range Filter -->
                <div class="filter-group">
                    <div class="filter-title">Price Range ($)</div>
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min" value="@Model.MinPrice" min="0" step="10" />
                        <span class="text-muted">-</span>
                        <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max" value="@Model.MaxPrice" min="0" step="10" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-nexus-primary w-100 rounded-pill py-2">Apply Filter</button>
                </div>

                <!-- Reset button -->
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategorySlug) || Model.SelectedCategoryId.HasValue || Model.OnlyInStock || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                {
                    <div class="mt-3 text-center">
                        <a asp-action="Index" class="text-danger small text-decoration-none fw-bold">
                            ✕ Clear All Filters
                        </a>
                    </div>
                }
            </form>
        </aside>

        <!-- Products Grid Area -->
        <main>
            @if (Model.Products.Count == 0)
            {
                <div class="text-center py-5 bg-white rounded-3 border p-5 shadow-sm">
                    <div style="font-size: 3rem;">🔍</div>
                    <h3 class="mt-3 fw-bold" style="font-family: var(--font-heading); text-transform: uppercase;">No Products Found</h3>
                    <p class="text-muted">No items matched your current filter criteria.</p>
                    <a asp-action="Index" class="btn-nexus-primary mt-2">View All Products</a>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var product in Model.Products)
                    {
                        var badgeClass = "top-seller";
                        if (!string.IsNullOrEmpty(product.Badge))
                        {
                            if (product.Badge.Contains("Sale") || product.Badge.Contains("%") || product.Badge.Contains("Off"))
                            {
                                badgeClass = "sale";
                            }
                            else if (product.Badge.Contains("New") || product.Badge.Contains("Drop"))
                            {
                                badgeClass = "new";
                            }
                        }

                        <div class="product-card" id="catalog-product-@product.Id">
                            <div class="product-img-wrap">
                                @if (!string.IsNullOrEmpty(product.Badge))
                                {
                                    <span class="product-badge @badgeClass">
                                        @product.Badge
                                    </span>
                                }
                                else if (!product.InStock)
                                {
                                    <span class="product-badge" style="background: #64748b; color: #ffffff;">Sold Out</span>
                                }

                                <a asp-action="Details" asp-route-id="@product.Id" asp-route-slug="@product.Slug">
                                    <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                                </a>

                                @if (product.InStock)
                                {
                                    <div class="product-quick-add-overlay">
                                        <button type="button" class="btn-card-quick-add" data-quick-add="@product.Id">
                                            + Quick Add to Bag
                                        </button>
                                    </div>
                                }
                            </div>

                            <div class="product-body">
                                <div class="product-category-chip">@product.Category?.Name</div>
                                <a asp-action="Details" asp-route-id="@product.Id" asp-route-slug="@product.Slug">
                                    <h3 class="product-name">@product.Name</h3>
                                </a>
                                <p class="product-desc-snippet">@product.ShortDescription</p>

                                <div class="product-rating">
                                    <span>★</span>
                                    <span class="product-rating-score">@product.Rating.ToString("0.0")</span>
                                    <span class="product-rating-count">(@product.ReviewCount)</span>
                                </div>

                                <div class="product-footer">
                                    <div class="product-price-box">
                                        <span class="product-price">$@product.Price.ToString("0.00")</span>
                                        @if (product.CompareAtPrice.HasValue && product.CompareAtPrice > product.Price)
                                        {
                                            <span class="product-compare-price">$@product.CompareAtPrice.Value.ToString("0.00")</span>
                                        }
                                    </div>

                                    @if (product.InStock)
                                    {
                                        <button type="button" 
                                                class="btn-add-cart-quick" 
                                                data-quick-add="@product.Id"
                                                title="Add to cart"
                                                aria-label="Add @product.Name to cart">
                                            +
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white py-1 px-2" style="font-size: 0.72rem;">Out of Stock</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>
