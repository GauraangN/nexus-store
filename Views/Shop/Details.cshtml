@model NexusStore.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as List<NexusStore.Models.Product> ?? new List<NexusStore.Models.Product>();
}

<div class="container-fluid px-3 px-md-4 py-4 max-w-1320" style="max-width: 1200px; margin: 0 auto;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-2" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Shop</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.Category?.Slug">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Product Details Main Layout -->
    <div class="product-detail-layout" style="margin: 0; padding: 0;">
        <!-- Left: Product Image Showcase -->
        <div>
            <div class="gallery-main">
                <img id="mainProductImage" src="@Model.ImageUrl" alt="@Model.Name" />
            </div>

            @if (!string.IsNullOrEmpty(Model.SecondaryImageUrl))
            {
                <div class="d-flex gap-3">
                    <img src="@Model.ImageUrl" 
                         alt="Main view" 
                         class="rounded-3 border border-2 border-primary" 
                         style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                         onclick="document.getElementById('mainProductImage').src = this.src" />
                    <img src="@Model.SecondaryImageUrl" 
                         alt="Alternate view" 
                         class="rounded-3 border" 
                         style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                         onclick="document.getElementById('mainProductImage').src = this.src" />
                </div>
            }
        </div>

        <!-- Right: Information & Actions -->
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="product-category-chip mb-0">@Model.Category?.Name</span>
                <span class="text-muted">•</span>
                <span class="small text-muted">SKU: @Model.Sku</span>
            </div>

            <h1 style="font-size: 2.4rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.75rem;">
                @Model.Name
            </h1>

            <!-- Ratings -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="product-rating mb-0" style="font-size: 1rem;">
                    <span>★</span>
                    <span class="product-rating-score">@Model.Rating.ToString("0.0")</span>
                </div>
                <span class="text-muted small">(@Model.ReviewCount verified reviews)</span>
                <span class="text-muted">•</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle">Verified Authentic</span>
            </div>

            <!-- Price -->
            <div class="d-flex align-items-baseline gap-3 mb-4">
                <span style="font-size: 2.2rem; font-weight: 800; font-family: var(--font-heading); color: #0f172a;">
                    $@Model.Price.ToString("0.00")
                </span>
                @if (Model.CompareAtPrice.HasValue && Model.CompareAtPrice > Model.Price)
                {
                    <span style="font-size: 1.3rem; color: #94a3b8; text-decoration: line-through;">
                        $@Model.CompareAtPrice.Value.ToString("0.00")
                    </span>
                    <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold">
                        Save @Model.DiscountPercent%
                    </span>
                }
            </div>

            <!-- Stock status indicator -->
            <div class="mb-4">
                @if (Model.StockQuantity > 5)
                {
                    <div class="d-flex align-items-center gap-2 text-success fw-bold small">
                        <span style="width: 10px; height: 10px; background: #10b981; border-radius: 50%; display: inline-block;"></span>
                        In Stock (@Model.StockQuantity units ready to ship)
                    </div>
                }
                else if (Model.StockQuantity > 0)
                {
                    <div class="d-flex align-items-center gap-2 text-warning fw-bold small">
                        <span style="width: 10px; height: 10px; background: #f59e0b; border-radius: 50%; display: inline-block;"></span>
                        Hurry! Only @Model.StockQuantity left in stock
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 text-danger fw-bold small">
                        <span style="width: 10px; height: 10px; background: #ef4444; border-radius: 50%; display: inline-block;"></span>
                        Currently Out of Stock
                    </div>
                }
            </div>

            <p style="color: #475569; font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.5rem;">
                @Model.Description
            </p>

            <!-- Feature Specs -->
            @if (!string.IsNullOrEmpty(Model.Features))
            {
                <div class="mb-4">
                    <div class="small fw-bold text-uppercase text-muted mb-2">Key Specifications</div>
                    <div>
                        @foreach (var feat in Model.Features.Split(';', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="spec-badge-pill">✓ @feat.Trim()</span>
                        }
                    </div>
                </div>
            }

            <hr class="my-4" style="border-color: #e2e8f0;" />

            <!-- Add to Cart Form -->
            @if (Model.InStock)
            {
                <div class="d-flex align-items-center gap-3 mb-4">
                    <!-- Quantity Stepper -->
                    <div class="d-flex align-items-center border rounded-pill bg-light p-1">
                        <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none px-3" onclick="adjustDetailQty(-1)">−</button>
                        <input type="number" id="detailQtyInput" value="1" min="1" max="@Model.StockQuantity" 
                               class="form-control form-control-sm text-center border-0 bg-transparent fw-bold" 
                               style="width: 50px;" readonly />
                        <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none px-3" onclick="adjustDetailQty(1)">+</button>
                    </div>

                    <button type="button" 
                            class="btn-nexus-primary flex-grow-1 py-3" 
                            id="btnDetailAddToCart"
                            onclick="addToCart(@Model.Id, parseInt(document.getElementById('detailQtyInput').value) || 1)">
                        <span>🛍️ Add to Cart</span>
                    </button>
                </div>
            }
            else
            {
                <button class="btn btn-secondary w-100 py-3 rounded-pill mb-4" disabled>Out of Stock</button>
            }

            <!-- Trust Badges Under Add To Cart -->
            <div class="border rounded-3 p-3 bg-white shadow-sm">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span style="font-size: 1.2rem;">🚚</span>
                    <span class="small text-muted"><strong>Fast Shipping:</strong> Dispatched within 24 hours with full tracking</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size: 1.2rem;">🔄</span>
                    <span class="small text-muted"><strong>30-Day Returns:</strong> If you're not completely satisfied, return free</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mt-5 pt-5 border-top">
            <h2 class="section-title mb-4">Related in @Model.Category?.Name</h2>
            <div class="product-grid">
                @foreach (var rel in related)
                {
                    <div class="product-card">
                        <div class="product-img-wrap">
                            <a asp-action="Details" asp-route-id="@rel.Id" asp-route-slug="@rel.Slug">
                                <img src="@rel.ImageUrl" alt="@rel.Name" loading="lazy" />
                            </a>
                        </div>
                        <div class="product-body">
                            <div class="product-category-chip">@rel.Category?.Name</div>
                            <a asp-action="Details" asp-route-id="@rel.Id" asp-route-slug="@rel.Slug">
                                <h3 class="product-name">@rel.Name</h3>
                            </a>
                            <div class="product-footer">
                                <span class="product-price">$@rel.Price.ToString("0.00")</span>
                                <button type="button" class="btn-add-cart-quick" data-quick-add="@rel.Id">+</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function adjustDetailQty(delta) {
            const input = document.getElementById('detailQtyInput');
            let current = parseInt(input.value) || 1;
            const max = parseInt(input.getAttribute('max')) || 99;
            current += delta;
            if (current < 1) current = 1;
            if (current > max) current = max;
            input.value = current;
        }
    </script>
}
