@model NexusStore.Models.Order
@{
    ViewData["Title"] = "Track Your Order";
    var searched = ViewBag.Searched as bool? ?? false;
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="container-fluid px-3 px-md-4 py-5 max-w-1320" style="max-width: 800px; margin: 0 auto;">
    <div class="text-center mb-4">
        <h1 style="font-size: 2.2rem; font-weight: 800;">Track Your Order</h1>
        <p class="text-muted">Enter your order confirmation number to check dispatch status in real-time.</p>
    </div>

    <!-- Lookup Form -->
    <div class="bg-white border rounded-4 p-4 shadow-sm mb-4">
        <form method="get" asp-action="Track" class="d-flex gap-2">
            <input type="text" name="orderNumber" value="@searchTerm" 
                   placeholder="e.g. NEX-2026-9041" 
                   class="form-control form-control-lg rounded-pill px-4 font-monospace" required />
            <button type="submit" class="btn btn-nexus-primary px-4 text-nowrap">
                Track Status →
            </button>
        </form>
        <div class="small text-muted mt-2">
            Try sample order number: <code class="text-primary fw-bold">NEX-2026-9041</code> or <code class="text-primary fw-bold">NEX-2026-9042</code>
        </div>
    </div>

    <!-- Results -->
    @if (searched)
    {
        if (Model == null)
        {
            <div class="alert alert-warning text-center rounded-4 p-4">
                <h5>Order Not Found</h5>
                <p class="mb-0 text-muted">No matching order was found for "<strong>@searchTerm</strong>". Please double check your order number.</p>
            </div>
        }
        else
        {
            <div class="bg-white border rounded-4 p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-5 fw-bold font-monospace">@Model.OrderNumber</span>
                    <span class="badge @(Model.Status == NexusStore.Models.OrderStatus.Delivered ? "bg-success" : "bg-primary") px-3 py-2 rounded-pill">
                        @Model.Status
                    </span>
                </div>

                <div class="text-muted small mb-4">
                    Placed on @Model.CreatedAt.ToString("MMMM dd, yyyy • HH:mm") by @Model.CustomerName
                </div>

                <div class="order-tracker-bar mb-4">
                    <div class="tracker-step completed">
                        <div class="tracker-dot">✓</div>
                        <div class="small fw-bold">Placed</div>
                    </div>
                    <div class="tracker-step @(Model.Status >= NexusStore.Models.OrderStatus.Processing ? "completed" : "")">
                        <div class="tracker-dot">@(Model.Status >= NexusStore.Models.OrderStatus.Processing ? "✓" : "2")</div>
                        <div class="small fw-bold">Processing</div>
                    </div>
                    <div class="tracker-step @(Model.Status >= NexusStore.Models.OrderStatus.Shipped ? "completed" : "")">
                        <div class="tracker-dot">@(Model.Status >= NexusStore.Models.OrderStatus.Shipped ? "✓" : "3")</div>
                        <div class="small fw-bold">Shipped</div>
                    </div>
                    <div class="tracker-step @(Model.Status == NexusStore.Models.OrderStatus.Delivered ? "completed" : "")">
                        <div class="tracker-dot">@(Model.Status == NexusStore.Models.OrderStatus.Delivered ? "✓" : "4")</div>
                        <div class="small fw-bold">Delivered</div>
                    </div>
                </div>

                <div class="border-top pt-3">
                    <div class="fw-bold mb-2 small text-uppercase text-muted">Items In Package</div>
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between small py-1">
                            <span>@item.ProductName (x@item.Quantity)</span>
                            <span class="fw-bold">$@item.TotalPrice.ToString("0.00")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between fw-bold pt-2 border-top mt-2">
                        <span>Total Paid</span>
                        <span class="text-primary font-monospace">$@Model.TotalAmount.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        }
    }
</div>
