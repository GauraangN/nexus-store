@model List<NexusStore.Models.Product>
@{
    ViewData["Title"] = "Inventory Management";
    var categories = ViewBag.Categories as List<NexusStore.Models.Category> ?? new List<NexusStore.Models.Category>();
    var search = ViewBag.Search as string;
    var selectedCatId = ViewBag.CategoryId as int?;
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 1320px; margin: 0 auto;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1" style="font-size: 0.85rem;">
                    <li class="breadcrumb-item"><a asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Products</li>
                </ol>
            </nav>
            <h1 class="fw-bold mb-0" style="font-size: 2rem;">Product Inventory Management</h1>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="CreateProduct" class="btn btn-primary rounded-pill px-3 shadow-sm">
                + Add New Product
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                ← Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white border rounded-4 p-3 shadow-sm mb-4">
        <form method="get" asp-action="Products" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" value="@search" placeholder="Search by name, SKU, or tag..." class="form-control form-control-sm rounded-pill px-3" />
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(selectedCatId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(search) || selectedCatId.HasValue)
                {
                    <a asp-action="Products" class="btn btn-sm btn-outline-danger rounded-pill px-2">Reset</a>
                }
            </div>
        </form>
    </div>

    <!-- Products Table -->
    <div class="bg-white border rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="text-muted small text-uppercase">
                    <tr>
                        <th>Product Details</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Level</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@prod.ImageUrl" alt="@prod.Name" class="rounded-3 border" style="width: 50px; height: 50px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-bold small">@prod.Name</div>
                                        <div class="text-muted font-monospace" style="font-size: 0.72rem;">SKU: @prod.Sku</div>
                                    </div>
                                </div>
                            </td>
                            <td class="small fw-semibold">@prod.Category?.Name</td>
                            <td class="fw-bold font-monospace">$@prod.Price.ToString("0.00")</td>
                            <td>
                                @if (prod.StockQuantity <= 5)
                                {
                                    <span class="badge bg-danger-subtle text-danger fw-bold">
                                        @prod.StockQuantity units (Low)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success fw-bold">
                                        @prod.StockQuantity units
                                    </span>
                                }
                            </td>
                            <td class="small">★ @prod.Rating.ToString("0.0")</td>
                            <td>
                                @if (prod.IsFeatured)
                                {
                                    <span class="badge bg-primary rounded-pill">Featured</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark rounded-pill border">Standard</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="EditProduct" asp-route-id="@prod.Id" class="btn btn-outline-secondary" title="Edit Product">
                                        ✏️ Edit
                                    </a>
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@prod.Id" target="_blank" class="btn btn-outline-info" title="View Storefront">
                                        👁️ View
                                    </a>
                                    <form method="post" asp-action="DeleteProduct" asp-route-id="@prod.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Product">
                                            🗑️
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
