@model NexusStore.Models.Product
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Product" : "Create Product";
    var action = isEdit ? "EditProduct" : "CreateProduct";
}

<div class="container-fluid px-3 px-md-4 py-4" style="max-width: 900px; margin: 0 auto;">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1" style="font-size: 0.85rem;">
                <li class="breadcrumb-item"><a asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item"><a asp-action="Products">Products</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(isEdit ? "Edit" : "New")</li>
            </ol>
        </nav>
        <h1 class="fw-bold" style="font-size: 2rem;">@(isEdit ? $"Edit '{Model.Name}'" : "Add New Product")</h1>
    </div>

    <form method="post" asp-action="@action" asp-route-id="@(isEdit ? Model.Id : null)" class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
        @Html.AntiForgeryToken()
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
        }

        <div class="row g-3">
            <!-- Product Title -->
            <div class="col-md-8">
                <label asp-for="Name" class="form-label small fw-bold">Product Title *</label>
                <input asp-for="Name" class="form-control form-control-custom" placeholder="e.g. Horizon Mechanical Keyboard" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- SKU -->
            <div class="col-md-4">
                <label asp-for="Sku" class="form-label small fw-bold">SKU Code</label>
                <input asp-for="Sku" class="form-control form-control-custom font-monospace" placeholder="NX-KBD-09" />
                <span asp-validation-for="Sku" class="text-danger small"></span>
            </div>

            <!-- Category -->
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label small fw-bold">Category *</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select form-control-custom" required>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <!-- Badge -->
            <div class="col-md-6">
                <label asp-for="Badge" class="form-label small fw-bold">Promotional Badge (Optional)</label>
                <input asp-for="Badge" class="form-control form-control-custom" placeholder="e.g. Best Seller, -20% Off, New" />
            </div>

            <!-- Price -->
            <div class="col-md-4">
                <label asp-for="Price" class="form-label small fw-bold">Current Price ($) *</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control form-control-custom" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <!-- Compare At Price -->
            <div class="col-md-4">
                <label asp-for="CompareAtPrice" class="form-label small fw-bold">Original Price ($) (Optional)</label>
                <input asp-for="CompareAtPrice" type="number" step="0.01" class="form-control form-control-custom" placeholder="Leave empty if no sale" />
            </div>

            <!-- Stock Quantity -->
            <div class="col-md-4">
                <label asp-for="StockQuantity" class="form-label small fw-bold">Stock Inventory *</label>
                <input asp-for="StockQuantity" type="number" class="form-control form-control-custom" required />
                <span asp-validation-for="StockQuantity" class="text-danger small"></span>
            </div>

            <!-- Image URL -->
            <div class="col-md-6">
                <label asp-for="ImageUrl" class="form-label small fw-bold">Main Image URL *</label>
                <input asp-for="ImageUrl" class="form-control form-control-custom" placeholder="https://images.unsplash.com/..." required />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <!-- Secondary Image URL -->
            <div class="col-md-6">
                <label asp-for="SecondaryImageUrl" class="form-label small fw-bold">Secondary Image URL (Optional)</label>
                <input asp-for="SecondaryImageUrl" class="form-control form-control-custom" placeholder="https://images.unsplash.com/..." />
            </div>

            <!-- Short Description -->
            <div class="col-12">
                <label asp-for="ShortDescription" class="form-label small fw-bold">Short Catchy Summary</label>
                <input asp-for="ShortDescription" class="form-control form-control-custom" placeholder="1-2 sentences highlighting benefits" />
            </div>

            <!-- Full Description -->
            <div class="col-12">
                <label asp-for="Description" class="form-label small fw-bold">Full Product Description *</label>
                <textarea asp-for="Description" rows="4" class="form-control form-control-custom" placeholder="Detailed product story, materials, and benefits..." required></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Features / Specifications -->
            <div class="col-12">
                <label asp-for="Features" class="form-label small fw-bold">Key Specifications (Semicolon ';' separated)</label>
                <input asp-for="Features" class="form-control form-control-custom" placeholder="Bluetooth 5.4;40h Battery;Custom Drivers;Water Resistant" />
            </div>

            <!-- Rating & Reviews -->
            <div class="col-md-4">
                <label asp-for="Rating" class="form-label small fw-bold">Rating (0 - 5.0)</label>
                <input asp-for="Rating" type="number" step="0.1" min="1" max="5" class="form-control form-control-custom" />
            </div>

            <div class="col-md-4">
                <label asp-for="ReviewCount" class="form-label small fw-bold">Review Count</label>
                <input asp-for="ReviewCount" type="number" class="form-control form-control-custom" />
            </div>

            <div class="col-md-4 d-flex align-items-center mt-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="isFeaturedSwitch" />
                    <label class="form-check-label fw-bold small" for="isFeaturedSwitch">Featured Product</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a asp-action="Products" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                @(isEdit ? "Update Product" : "Save Product")
            </button>
        </div>
    </form>
</div>
