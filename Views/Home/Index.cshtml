@model NexusStore.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Engineered Performance Tech, Home & Lifestyle Goods";
}

<!-- Hero Section - High-Impact Athletic D2C Editorial Style -->
<div class="container-fluid px-3 px-md-4">
    <section class="hero-banner" id="heroBanner">
        <div class="hero-content">
            <div class="hero-tag">
                <span>⚡</span>
                <span>NEW SEASON DROP // PERFORMANCE LIVING</span>
            </div>
            <h1 class="hero-title">
                Precision Crafted.<br/>Built for Movement.
            </h1>
            <p class="hero-subtitle">
                High-performance audio gear, curated modern home essentials, and weatherproof everyday carry engineered for modern daily life and athletic precision.
            </p>
            <div class="hero-cta-group">
                <a asp-controller="Shop" asp-action="Index" class="btn-nexus-volt" id="btnHeroShop">
                    Shop Latest Drops →
                </a>
                <a asp-controller="Shop" asp-action="Index" asp-route-category="lifestyle-gear" class="btn-nexus-secondary" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); color: #ffffff;">
                    Browse Everyday Gear
                </a>
            </div>

            <!-- Trust Bar Inside Hero -->
            <div class="hero-trust-bar">
                <div class="hero-trust-item">
                    <span style="color: #f59e0b;">★★★★★</span>
                    <span><strong>4.9 / 5.0</strong> Customer Rating</span>
                </div>
                <div class="hero-trust-item">
                    <span>🚀</span>
                    <span><strong>Free Express Shipping</strong> over $100</span>
                </div>
                <div class="hero-trust-item">
                    <span>🛡️</span>
                    <span><strong>30-Day</strong> Risk-Free Trial</span>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Quick Category Navigation Pill Bar (Fuaark / Activewear D2C Style) -->
<div class="quick-categories-bar">
    <a asp-controller="Shop" asp-action="Index" class="category-quick-pill active">
        <span>✦ All Collections</span>
        <span class="pill-count">@Model.FeaturedProducts.Count+</span>
    </a>
    <a asp-controller="Shop" asp-action="Index" asp-route-category="electronics" class="category-quick-pill">
        <span>🎧 Tech & Audio</span>
    </a>
    <a asp-controller="Shop" asp-action="Index" asp-route-category="lifestyle-gear" class="category-quick-pill">
        <span>🎒 Lifestyle & EDC</span>
    </a>
    <a asp-controller="Shop" asp-action="Index" asp-route-category="home-living" class="category-quick-pill">
        <span>🛋️ Modern Living</span>
    </a>
    <a asp-controller="Shop" asp-action="Index" asp-route-sort="rating" class="category-quick-pill">
        <span>🔥 Best Sellers</span>
    </a>
    <a asp-controller="Shop" asp-action="Index" asp-route-maxPrice="50" class="category-quick-pill">
        <span>🏷️ Under $50</span>
    </a>
</div>

<!-- Featured Products Section with Interactive Filter Tabs -->
<section class="products-container">
    <div class="section-header">
        <div>
            <h2 class="section-title">Trending Drops & Best Sellers</h2>
            <div class="section-subtitle">Engineered to elevate your everyday kit with minimalist precision.</div>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn-nexus-outline d-none d-sm-inline-flex">
            View All Catalog (@Model.FeaturedProducts.Count +) →
        </a>
    </div>

    <!-- Category Tabs Filter -->
    <div class="showcase-tabs-nav">
        <button type="button" class="showcase-tab-btn active" onclick="filterShowcase('all', this)">All Drops</button>
        <button type="button" class="showcase-tab-btn" onclick="filterShowcase('electronics', this)">Tech & Audio</button>
        <button type="button" class="showcase-tab-btn" onclick="filterShowcase('lifestyle-gear', this)">Lifestyle & Gear</button>
        <button type="button" class="showcase-tab-btn" onclick="filterShowcase('home-living', this)">Modern Living</button>
    </div>

    <!-- Product Grid (Tall Portrait Aspect Ratio Cards) -->
    <div class="product-grid" id="homeProductGrid">
        @foreach (var product in Model.FeaturedProducts)
        {
            var badgeClass = "top-seller";
            if (!string.IsNullOrEmpty(product.Badge))
            {
                if (product.Badge.Contains("Sale") || product.Badge.Contains("%") || product.Badge.Contains("Off"))
                {
                    badgeClass = "sale";
                }
                else if (product.Badge.Contains("New") || product.Badge.Contains("Drop"))
                {
                    badgeClass = "new";
                }
            }

            <div class="product-card product-showcase-item" id="product-card-@product.Id" data-category="@product.Category?.Slug">
                <div class="product-img-wrap">
                    @if (!string.IsNullOrEmpty(product.Badge))
                    {
                        <span class="product-badge @badgeClass">
                            @product.Badge
                        </span>
                    }
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" asp-route-slug="@product.Slug">
                        <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                    </a>

                    <!-- Hover Quick Add Overlay -->
                    <div class="product-quick-add-overlay">
                        <button type="button" class="btn-card-quick-add" data-quick-add="@product.Id">
                            + Quick Add to Bag
                        </button>
                    </div>
                </div>

                <div class="product-body">
                    <div class="product-category-chip">@product.Category?.Name</div>
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" asp-route-slug="@product.Slug">
                        <h3 class="product-name">@product.Name</h3>
                    </a>
                    <p class="product-desc-snippet">@product.ShortDescription</p>

                    <div class="product-rating">
                        <span>★</span>
                        <span class="product-rating-score">@product.Rating.ToString("0.0")</span>
                        <span class="product-rating-count">(@product.ReviewCount reviews)</span>
                    </div>

                    <div class="product-footer">
                        <div class="product-price-box">
                            <span class="product-price">$@product.Price.ToString("0.00")</span>
                            @if (product.CompareAtPrice.HasValue && product.CompareAtPrice > product.Price)
                            {
                                <span class="product-compare-price">$@product.CompareAtPrice.Value.ToString("0.00")</span>
                            }
                        </div>

                        <button type="button" class="btn-add-cart-quick" data-quick-add="@product.Id" title="Add to Bag">
                            +
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Performance Innovation & Value Pillars -->
<div class="benefits-row" id="benefits">
    <div class="benefit-card">
        <div class="benefit-icon">⚡</div>
        <div>
            <div class="benefit-title">Precision Engineering</div>
            <div class="benefit-desc">Aerospace-grade materials and ergonomic design tested for durability.</div>
        </div>
    </div>
    <div class="benefit-card">
        <div class="benefit-icon">🚀</div>
        <div>
            <div class="benefit-title">Priority 24H Dispatch</div>
            <div class="benefit-desc">Complimentary express shipping on all orders over $100 with global tracking.</div>
        </div>
    </div>
    <div class="benefit-card">
        <div class="benefit-icon">🛡️</div>
        <div>
            <div class="benefit-title">30-Day Risk-Free Trial</div>
            <div class="benefit-desc">Hassle-free exchanges and instant refunds with prepaid return labels.</div>
        </div>
    </div>
    <div class="benefit-card">
        <div class="benefit-icon">🔒</div>
        <div>
            <div class="benefit-title">Encrypted Checkout Flow</div>
            <div class="benefit-desc">Enterprise 256-bit SSL encryption with real-time inventory ledger.</div>
        </div>
    </div>
</div>

<!-- Curated Lookbook & Editorial Spotlight Grid -->
<section class="editorial-grid">
    <div class="editorial-card" style="background-image: url('https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=1000&q=80');">
        <div class="editorial-card-content">
            <span class="editorial-badge">ACOUSTIC SERIES</span>
            <h3 class="editorial-title">Studio Sound.<br/>Zero Distractions.</h3>
            <p class="editorial-desc">Custom 40mm beryllium drivers and hybrid active noise cancellation designed for focused deep work.</p>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="electronics" class="btn-nexus-volt" style="padding: 0.65rem 1.4rem; font-size: 0.82rem;">
                Explore Tech Series →
            </a>
        </div>
    </div>

    <div class="editorial-card" style="background-image: url('https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=1000&q=80');">
        <div class="editorial-card-content">
            <span class="editorial-badge" style="background: #ffffff; color: #0a0c10;">EDC ESSENTIALS</span>
            <h3 class="editorial-title">Weatherproof.<br/>Uncompromising.</h3>
            <p class="editorial-desc">Cordura ballistic nylon and Grade 5 titanium hardware built for relentless urban commutes and travel.</p>
            <a asp-controller="Shop" asp-action="Index" asp-route-category="lifestyle-gear" class="btn-nexus-primary" style="background: #ffffff; color: #0a0c10; padding: 0.65rem 1.4rem; font-size: 0.82rem;">
                Browse Everyday Carry →
            </a>
        </div>
    </div>
</section>

<!-- Community Social Proof & Customer Reviews -->
