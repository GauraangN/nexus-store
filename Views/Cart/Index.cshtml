@model NexusStore.Models.Cart
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container-fluid px-3 px-md-4 py-4 max-w-1320" style="max-width: 1200px; margin: 0 auto;">
    <h1 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 1.5rem;">Your Shopping Cart</h1>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border p-5 shadow-sm">
            <div style="font-size: 4rem;">🛍️</div>
            <h2 class="mt-3 fw-bold">Your cart is currently empty</h2>
            <p class="text-muted mb-4">You haven't added any products to your shopping bag yet.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn-nexus-primary">Start Shopping Now →</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Cart Items List -->
            <div class="col-lg-8">
                <div class="bg-white border rounded-4 p-4 shadow-sm mb-4">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="text-muted small text-uppercase">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" alt="@item.ProductName" 
                                                     class="rounded-3 border" style="width: 70px; height: 70px; object-fit: cover;" />
                                                <div>
                                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId" 
                                                       class="fw-bold text-dark text-decoration-none">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="small text-muted">@item.CategoryName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">$@item.UnitPrice.ToString("0.00")</td>
                                        <td>
                                            <div class="d-flex align-items-center border rounded-pill bg-light p-1" style="width: fit-content;">
                                                <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none px-2 py-0" 
                                                        onclick="updateItemQty(@item.ProductId, @item.Quantity - 1)">−</button>
                                                <span class="fw-bold px-2" style="font-size: 0.9rem;">@item.Quantity</span>
                                                <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none px-2 py-0" 
                                                        onclick="updateItemQty(@item.ProductId, @item.Quantity + 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="fw-bold text-primary">$@item.TotalPrice.ToString("0.00")</td>
                                        <td>
                                            <button type="button" class="btn btn-sm text-danger" onclick="removeDrawerItem(@item.ProductId)" title="Remove item">
                                                ✕
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-controller="Shop" asp-action="Index" class="btn-nexus-outline">
                            ← Continue Shopping
                        </a>
                        <span class="text-muted small">@Model.TotalItems total item(s)</span>
                    </div>
                </div>

                <!-- Promo Coupon Code Card -->
                <div class="bg-white border rounded-4 p-4 shadow-sm">
                    <h5 class="fw-bold mb-3">Promotional Discount</h5>
                    @if (!string.IsNullOrEmpty(Model.CouponCode))
                    {
                        <div class="d-flex align-items-center justify-content-between bg-success-subtle border border-success-subtle rounded-3 p-3">
                            <div class="text-success fw-bold">
                                ✓ Applied Coupon: @Model.CouponCode
                            </div>
                            <form method="post" asp-action="RemoveCoupon">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Remove</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-action="ApplyCoupon" class="d-flex gap-2">
                            <input type="text" name="couponCode" placeholder="Enter promo code (e.g. DEMO20)" 
                                   class="form-control rounded-pill" style="max-width: 320px;" required />
                            <button type="submit" class="btn btn-nexus-primary rounded-pill px-4">Apply</button>
                        </form>
                        <div class="form-text mt-2">
                            💡 Demo Tip: Use code <strong class="text-primary">DEMO20</strong> for 20% off or <strong class="text-primary">SAVE10</strong> for 10% off.
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="bg-white border rounded-4 p-4 shadow-sm sticky-top" style="top: 6rem;">
                    <h4 class="fw-bold mb-4">Order Summary</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span class="fw-bold">$@Model.Subtotal.ToString("0.00")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Promo Discount</span>
                            <span class="fw-bold">−$@Model.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Estimated Shipping</span>
                        <span class="fw-bold">
                            @(Model.ShippingFee == 0 ? "FREE" : $"${Model.ShippingFee:0.00}")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Estimated Tax (8%)</span>
                        <span class="fw-bold">$@Model.EstimatedTax.ToString("0.00")</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Total</span>
                        <span class="fs-3 fw-bold text-dark font-monospace">$@Model.GrandTotal.ToString("0.00")</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn-nexus-primary w-100 py-3 text-center fw-bold fs-6">
                        Proceed to Checkout →
                    </a>

                    <div class="text-center mt-3 small text-muted">
                        🔒 Safe & Secure 256-Bit SSL Demo Checkout
                    </div>
                </div>
            </div>
        </div>
    }
</div>
