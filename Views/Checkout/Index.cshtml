@model NexusStore.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container-fluid px-3 px-md-4 py-4 max-w-1320" style="max-width: 1160px; margin: 0 auto;">
    <div class="mb-4">
        <h1 style="font-size: 2.2rem; font-weight: 800;">Checkout</h1>
        <p class="text-muted">Complete your demo order to test inventory and order processing.</p>
    </div>

    <form method="post" asp-action="PlaceOrder" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left: Checkout Forms -->
            <div class="col-lg-7">
                <!-- Step 1: Customer Contact -->
                <div class="checkout-card">
                    <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">1</span>
                        Contact Information
                    </h4>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CustomerName" class="form-label small fw-bold">Full Name</label>
                            <input asp-for="CustomerName" class="form-control form-control-custom" placeholder="John Doe" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerEmail" class="form-label small fw-bold">Email Address</label>
                            <input asp-for="CustomerEmail" type="email" class="form-control form-control-custom" placeholder="john@example.com" required />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label small fw-bold">Phone Number</label>
                            <input asp-for="CustomerPhone" class="form-control form-control-custom" placeholder="+1 (555) 000-0000" required />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Shipping Details -->
                <div class="checkout-card">
                    <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">2</span>
                        Shipping Address
                    </h4>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ShippingAddress" class="form-label small fw-bold">Street Address</label>
                            <input asp-for="ShippingAddress" class="form-control form-control-custom" placeholder="123 Main Street, Apt 4B" required />
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="City" class="form-label small fw-bold">City</label>
                            <input asp-for="City" class="form-control form-control-custom" placeholder="San Francisco" required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="State" class="form-label small fw-bold">State / Province</label>
                            <input asp-for="State" class="form-control form-control-custom" placeholder="CA" required />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PostalCode" class="form-label small fw-bold">Postal / ZIP</label>
                            <input asp-for="PostalCode" class="form-control form-control-custom" placeholder="94105" required />
                            <span asp-validation-for="PostalCode" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Country" class="form-label small fw-bold">Country</label>
                            <select asp-for="Country" class="form-select form-control-custom">
                                <option value="United States">United States</option>
                                <option value="Canada">Canada</option>
                                <option value="United Kingdom">United Kingdom</option>
                                <option value="Germany">Germany</option>
                                <option value="Australia">Australia</option>
                                <option value="Japan">Japan</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Payment Method -->
                <div class="checkout-card">
                    <h4 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem;">3</span>
                        Payment Method (Simulated Demo)
                    </h4>

                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="form-check p-3 border rounded-3 bg-light">
                            <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Credit Card (Demo)" id="payCard" checked />
                            <label class="form-check-label fw-bold d-flex justify-content-between align-items-center w-100" for="payCard">
                                <span>💳 Credit / Debit Card (Demo)</span>
                                <span class="badge bg-secondary">Demo Mode</span>
                            </label>
                        </div>

                        <div class="form-check p-3 border rounded-3">
                            <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Apple Pay / Google Pay" id="payWallet" />
                            <label class="form-check-label fw-bold" for="payWallet">
                                📱 Apple Pay / Google Pay (Demo)
                            </label>
                        </div>

                        <div class="form-check p-3 border rounded-3">
                            <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="Cash on Delivery" id="payCod" />
                            <label class="form-check-label fw-bold" for="payCod">
                                💵 Cash on Delivery
                            </label>
                        </div>
                    </div>

                    <!-- Demo Card Inputs -->
                    <div class="row g-2 p-3 bg-light rounded-3 border">
                        <div class="col-12">
                            <label class="small text-muted fw-bold">Demo Card Number</label>
                            <input asp-for="CardNumber" class="form-control form-control-sm font-monospace" />
                        </div>
                        <div class="col-6">
                            <label class="small text-muted fw-bold">Expiration</label>
                            <input asp-for="CardExpiry" class="form-control form-control-sm text-center" />
                        </div>
                        <div class="col-6">
                            <label class="small text-muted fw-bold">Security CVC</label>
                            <input asp-for="CardCvc" class="form-control form-control-sm text-center" />
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="checkout-card">
                    <label asp-for="OrderNotes" class="form-label small fw-bold">Order Notes / Delivery Instructions (Optional)</label>
                    <textarea asp-for="OrderNotes" class="form-control form-control-custom" rows="2" placeholder="e.g. Leave package by the front door ring bell"></textarea>
                </div>
            </div>

            <!-- Right: Sticky Order Summary -->
            <div class="col-lg-5">
                <div class="bg-white border rounded-4 p-4 shadow-sm sticky-top" style="top: 6rem;">
                    <h4 class="fw-bold mb-3">Order Summary</h4>

                    <!-- Items Preview -->
                    <div class="d-flex flex-column gap-3 mb-4" style="max-height: 280px; overflow-y: auto;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.ImageUrl" alt="@item.ProductName" 
                                     class="rounded-3 border" style="width: 54px; height: 54px; object-fit: cover;" />
                                <div class="flex-grow-1">
                                    <div class="fw-bold small text-truncate" style="max-width: 200px;">@item.ProductName</div>
                                    <div class="text-muted small">Qty: @item.Quantity × $@item.UnitPrice.ToString("0.00")</div>
                                </div>
                                <div class="fw-bold small text-end">$@item.TotalPrice.ToString("0.00")</div>
                            </div>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Items Subtotal</span>
                        <span class="fw-bold text-dark">$@Model.Cart.Subtotal.ToString("0.00")</span>
                    </div>

                    @if (Model.Cart.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Discount (@Model.Cart.CouponCode)</span>
                            <span class="fw-bold">−$@Model.Cart.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Express Delivery</span>
                        <span class="fw-bold text-dark">
                            @(Model.Cart.ShippingFee == 0 ? "FREE" : $"${Model.Cart.ShippingFee:0.00}")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Estimated Tax</span>
                        <span class="fw-bold text-dark">$@Model.Cart.EstimatedTax.ToString("0.00")</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold">Total Due</span>
                        <span class="fs-3 fw-bold text-dark font-monospace">$@Model.Cart.GrandTotal.ToString("0.00")</span>
                    </div>

                    <button type="submit" class="btn-nexus-primary w-100 py-3 text-center fw-bold fs-6" id="btnPlaceOrder">
                        🔒 Place Order & Generate Receipt
                    </button>

                    <div class="text-center mt-3 text-muted small">
                        This is a simulated demo transaction. No real credit card will be charged.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
